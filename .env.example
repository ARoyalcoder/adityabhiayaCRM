# Local development environment.
# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# --- PostgreSQL (docker/compose.yaml) ---
POSTGRES_DB=bos
POSTGRES_USER=bos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Redis (docker/compose.yaml) ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-only

# --- Backend (apps/api), read by scripts/dev-api.sh ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/bos
DB_USERNAME=bos
DB_PASSWORD=change-me-local-only
REDIS_HOST=localhost
# Log schema on stdout: ecs (default), logstash or gelf.
LOG_FORMAT=ecs

# --- Frontend (apps/web) ---
# Where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:8080
WEB_PORT=5173
# Host port of the Nginx container when running "npm run stack:up".
WEB_CONTAINER_PORT=8081
