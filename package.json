{
  "name": "pawan-putra-business-os",
  "private": true,
  "description": "Pawan Putra Business OS: monorepo root (frontend workspaces and development scripts)",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @pawanputra/web",
    "build:web": "npm run build --workspace @pawanputra/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "infra:up": "bash scripts/dev-infra.sh up",
    "infra:status": "bash scripts/dev-infra.sh status",
    "infra:logs": "bash scripts/dev-infra.sh logs",
    "infra:down": "bash scripts/dev-infra.sh down",
    "infra:reset": "bash scripts/dev-infra.sh reset",
    "stack:up": "bash scripts/dev-infra.sh stack",
    "check:services": "bash scripts/check-services.sh",
    "dev:api": "bash scripts/dev-api.sh",
    "test:api": "bash scripts/test-api.sh",
    "verify": "bash scripts/verify.sh"
  }
}
