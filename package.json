{
  "name": "pawan-putra-business-os",
  "private": true,
  "description": "Pawan Putra Business OS: monorepo root (frontend workspaces and development scripts)",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @pawanputra/web",
    "build:web": "npm run build --workspace @pawanputra/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "bash scripts/dev-db.sh up",
    "db:down": "bash scripts/dev-db.sh down",
    "db:logs": "bash scripts/dev-db.sh logs",
    "dev:api": "bash scripts/dev-api.sh",
    "test:api": "bash scripts/test-api.sh",
    "verify": "bash scripts/verify.sh"
  }
}
